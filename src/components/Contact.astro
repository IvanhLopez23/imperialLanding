---
import Icon from "./Icon.astro";
import { mapsUrl, openingHours, services, site, whatsappUrl } from "../data/site";
---

<!--
  Cierre de conversión: información práctica + formulario de reserva.
  El formulario no necesita backend: valida en cliente y abre WhatsApp con el
  mensaje ya redactado. Si más adelante quieres enviarlo a un endpoint,
  reemplaza el listener de "submit" por fetch().
-->
<section id="contacto" class="relative overflow-hidden bg-charcoal py-20 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="section-label">Contacto</p>
      <h2 class="section-title mt-4">Tu próximo corte empieza aquí</h2>
      <p class="mt-5 text-base leading-relaxed text-ivory-dim">
        Escríbenos, llámanos o pásate por el local. Respondemos en minutos durante el horario de
        atención.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-8">
      <!-- ---------- Tarjeta de información ---------- -->
      <div class="reveal flex flex-col rounded-2xl border border-gold/20 bg-leather p-7 sm:p-8">
        <p class="text-[11px] font-medium tracking-[0.28em] text-gold uppercase">Visítanos</p>

        <!-- Dirección -->
        <div class="mt-7 flex gap-4">
          <span class="mt-0.5 text-gold">
            <Icon name="map-pin" class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-serif text-lg text-ivory">Dirección</h3>
            <address class="mt-1.5 text-sm leading-relaxed text-ivory-dim not-italic">
              {site.address.street}<br />
              {site.address.neighborhood}, {site.address.city}<br />
              CP {site.address.zip}, {site.address.country}
            </address>
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex cursor-pointer items-center gap-1.5 text-[11px] font-medium tracking-[0.14em] text-gold uppercase transition-all duration-200 hover:gap-2.5"
            >
              Abrir en Google Maps
              <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>

        <hr class="my-7 border-ivory/10" />

        <!-- Horarios -->
        <div class="flex gap-4">
          <span class="mt-0.5 text-gold">
            <Icon name="clock" class="h-5 w-5" />
          </span>
          <div class="w-full">
            <h3 class="font-serif text-lg text-ivory">Horario</h3>
            <dl class="mt-3 space-y-2 text-sm">
              {
                openingHours.map((row) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-ivory-dim">{row.days}</dt>
                    <dd
                      class:list={[
                        "font-medium tabular-nums",
                        row.hours === "Cerrado" ? "text-ivory/40" : "text-gold",
                      ]}
                    >
                      {row.hours}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <hr class="my-7 border-ivory/10" />

        <!-- Teléfono / WhatsApp -->
        <div class="flex gap-4">
          <span class="mt-0.5 text-gold">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-serif text-lg text-ivory">Teléfono</h3>
            <a
              href={`tel:${site.phone}`}
              class="mt-1.5 inline-block text-sm text-ivory-dim transition-colors hover:text-gold"
            >
              {site.phoneDisplay}
            </a>
          </div>
        </div>

        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn mt-7 w-full border border-gold/40 bg-gold/10 text-gold hover:bg-gold hover:text-charcoal"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          Escribir por WhatsApp
        </a>
      </div>

      <!-- ---------- Formulario de reserva ---------- -->
      <div
        id="reservar"
        class="reveal scroll-mt-24 rounded-2xl bg-ivory p-7 text-charcoal sm:p-9"
      >
        <h3 class="font-serif text-2xl text-leather sm:text-3xl">Reserva tu cita</h3>
        <p class="mt-2 text-sm text-charcoal/65">
          Cuatro datos y listo. Te confirmamos por WhatsApp.
        </p>

        <form
          class="mt-7 grid gap-5 sm:grid-cols-2"
          data-booking-form
          data-whatsapp={site.whatsapp}
          novalidate
        >
          <div class="sm:col-span-2">
            <label for="nombre" class="field-label">Nombre</label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              class="field"
              placeholder="Tu nombre"
              autocomplete="name"
              required
            />
          </div>

          <div>
            <label for="telefono" class="field-label">Teléfono</label>
            <input
              id="telefono"
              name="telefono"
              type="tel"
              class="field"
              placeholder="55 1234 5678"
              autocomplete="tel"
              inputmode="tel"
              pattern="[0-9+()\s-]{8,20}"
              required
            />
          </div>

          <div>
            <label for="fecha" class="field-label">Fecha deseada</label>
            <input id="fecha" name="fecha" type="date" class="field" required data-date-input />
          </div>

          <div class="sm:col-span-2">
            <label for="servicio" class="field-label">Servicio</label>
            <select id="servicio" name="servicio" class="field cursor-pointer" required>
              <option value="" disabled selected>Selecciona un servicio</option>
              {services.map((service) => <option value={service.name}>{service.name}</option>)}
            </select>
          </div>

          <div class="sm:col-span-2">
            <button type="submit" class="btn btn-primary w-full">
              Solicitar cita
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>

            <p class="mt-4 text-xs leading-relaxed text-charcoal/60">
              Al enviar aceptas nuestra{" "}
              <a
                href="/privacidad"
                class="font-medium text-gold-ink underline decoration-gold/40 underline-offset-2 transition-colors hover:decoration-gold-ink"
              >política de privacidad</a>. No compartimos tus datos.
            </p>

            <!-- Confirmación accesible -->
            <p
              class="mt-4 hidden rounded-lg border border-gold/40 bg-gold/10 px-4 py-3 text-sm text-charcoal"
              role="status"
              aria-live="polite"
              data-form-status
            >
            </p>

            <!-- Refuerzo de confianza -->
            <ul
              class="mt-6 grid gap-2.5 border-t border-charcoal/10 pt-5 text-xs text-charcoal/70 sm:grid-cols-2"
            >
              <li class="flex items-center gap-2">
                <Icon name="check" class="h-4 w-4 shrink-0 text-gold-ink" />
                Confirmación por WhatsApp
              </li>
              <li class="flex items-center gap-2">
                <Icon name="check" class="h-4 w-4 shrink-0 text-gold-ink" />
                Sin pago por adelantado
              </li>
            </ul>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-booking-form]");
  const dateInput = document.querySelector<HTMLInputElement>("[data-date-input]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");

  if (form) {
    const serviceSelect = form.querySelector<HTMLSelectElement>("#servicio");

    // 1) Fecha mínima = hoy (zona horaria local, no UTC).
    if (dateInput) {
      const now = new Date();
      const localISO = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
        .toISOString()
        .slice(0, 10);
      dateInput.min = localISO;
    }

    // 2) Preselección del servicio al pulsar "Reservar" en una tarjeta.
    document.querySelectorAll<HTMLElement>("[data-service]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const value = trigger.dataset.service;
        if (value && serviceSelect) serviceSelect.value = value;
      });
    });

    // 3) Validación nativa + apertura de WhatsApp con el mensaje redactado.
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const nombre = String(data.get("nombre") ?? "").trim();
      const telefono = String(data.get("telefono") ?? "").trim();
      const servicio = String(data.get("servicio") ?? "").trim();
      const fechaRaw = String(data.get("fecha") ?? "").trim();

      const fecha = fechaRaw
        ? new Date(`${fechaRaw}T12:00:00`).toLocaleDateString("es-MX", {
            weekday: "long",
            day: "numeric",
            month: "long",
          })
        : "por confirmar";

      const message = [
        "Hola, quiero reservar una cita en Barbería Imperial.",
        `Nombre: ${nombre}`,
        `Teléfono: ${telefono}`,
        `Servicio: ${servicio}`,
        `Fecha deseada: ${fecha}`,
      ].join("\n");

      // El número se inyecta desde src/data/site.ts vía el atributo data-whatsapp
      const whatsapp = form.dataset.whatsapp ?? "";
      const url = `https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`;

      const opened = window.open(url, "_blank", "noopener,noreferrer");
      if (!opened) window.location.href = url;

      if (status) {
        status.textContent =
          "Abrimos WhatsApp con tu solicitud lista. Envía el mensaje para confirmar la cita.";
        status.classList.remove("hidden");
      }
    });
  }
</script>
