---
import Icon from "./Icon.astro";
import { nav, site, whatsappUrl } from "../data/site";
---

<!--
  Header fijo y translúcido.
  - En desktop: navegación inline + CTA.
  - En móvil: botón hamburguesa que controla el panel accesible (aria-expanded,
    cierre con Escape, bloqueo de scroll y cierre al navegar).
-->
<header class="site-header" data-header>
  <div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6 lg:h-20 lg:px-8">
    <!-- Logo tipográfico -->
    <a
      href="#inicio"
      class="group flex shrink-0 flex-col leading-none"
      aria-label={`${site.name} — Inicio`}
    >
      <span
        class="font-serif text-xl font-semibold tracking-[0.32em] text-ivory transition-colors duration-200 group-hover:text-gold sm:text-2xl"
      >
        IMPERIAL
      </span>
      <span class="mt-1.5 text-[9px] font-medium tracking-[0.42em] text-gold/90 uppercase sm:text-[10px]">
        Barber Club
      </span>
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-9">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={`tel:${site.phone}`} class="nav-link text-sm">
        {site.phoneDisplay}
      </a>
      <a href="#reservar" class="btn btn-primary px-6 py-3 text-[13px]">
        Reservar cita
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <!-- Botón menú móvil -->
    <button
      type="button"
      class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-ivory/20 text-ivory transition-colors hover:border-gold hover:text-gold lg:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Icon name="menu" class="h-5 w-5" data-icon-open />
      <Icon name="close" class="hidden h-5 w-5" data-icon-close />
    </button>
  </div>

  <!-- Panel móvil -->
  <div
    id="mobile-menu"
    class="border-t border-line/60 bg-charcoal/95 backdrop-blur-md lg:hidden"
    data-mobile-menu
  >
    <nav class="mx-auto max-w-6xl px-4 py-6 sm:px-6" aria-label="Navegación móvil">
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between rounded-lg px-3 py-3.5 text-base text-ivory/90 transition-colors hover:bg-ivory/5 hover:text-gold"
              >
                {item.label}
                <Icon name="arrow-up-right" class="h-4 w-4 text-gold/60" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-5 flex flex-col gap-3 border-t border-line/60 pt-5">
        <a href="#reservar" class="btn btn-primary w-full">Reservar cita</a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline w-full"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          WhatsApp
        </a>
        <p class="pt-1 text-center text-xs text-muted">
          {site.address.street} · {site.address.neighborhood}
        </p>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const iconOpen = document.querySelector<SVGElement>("[data-icon-open]");
  const iconClose = document.querySelector<SVGElement>("[data-icon-close]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  if (header && toggle && mobileMenu) {
    const setOpen = (open: boolean) => {
      header.dataset.navOpen = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      // Evita el scroll del fondo mientras el panel está abierto.
      document.documentElement.classList.toggle("overflow-hidden", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Al elegir un enlace, cerramos el panel.
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    // Cierre con Escape y devolución del foco al botón.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // Si se pasa a desktop, el panel debe quedar cerrado.
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });

    // Fondo sólido al hacer scroll (una sola lectura por frame).
    let ticking = false;
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
      ticking = false;
    };

    onScroll();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
  }
</script>
